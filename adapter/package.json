{
  "name": "paperclip-adapter-hermes-control",
  "version": "0.4.0",
  "description": "Hermes Control adapter for Paperclip: the agent name picks its Hermes instance/profile; Provider and Model menus list what Hermes knows; skills assigned in Paperclip are linked into that profile's skills folder. Drop-in override of the built-in hermes_local adapter.",
  "author": "Cyril M",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./ui-parser": "./ui-parser.cjs"
  },
  "paperclip": {
    "adapterUiParser": "1.0.0"
  },
  "files": [
    "dist/**/*.js",
    "ui-parser.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@paperclipai/hermes-paperclip-adapter": "2026.1001.0",
    "yaml": "^2.6.0",
    "@paperclipai/adapter-utils": "2026.1001.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CryptoDjam/hermes-control.git",
    "directory": "adapter"
  },
  "homepage": "https://github.com/CryptoDjam/hermes-control#readme",
  "bugs": {
    "url": "https://github.com/CryptoDjam/hermes-control/issues"
  },
  "keywords": [
    "paperclip",
    "paperclip-adapter",
    "hermes",
    "hermes-agent",
    "nous-research"
  ]
}
