{
  "name": "paperclip-adapter-hermes-control",
  "version": "0.6.3",
  "description": "Hermes Control adapter for Paperclip: the agent runs only in the Hermes profile explicitly assigned to it (assignments table shared with the plugin), launched with the administered Hermes binary and a controlled environment; configuration refusals are not retried; Provider and Model menus list what Hermes knows; skills assigned in Paperclip are linked into that profile's skills folder. Drop-in override of the built-in hermes_local adapter.",
  "author": "Cyril M",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./ui-parser": "./ui-parser.cjs"
  },
  "paperclip": {
    "adapterUiParser": "1.0.0"
  },
  "files": [
    "dist/**/*.js",
    "ui-parser.cjs",
    "README.md",
    "LICENSE",
    "voie1/patches/*.patch",
    "voie1/origine/*",
    "voie1/fabriquer.sh",
    "voie1/LICENCES.md",
    "voie1/paquets/*.tgz",
    "voie1/paquets/SHA256SUMS"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "voie1": "bash voie1/fabriquer.sh"
  },
  "dependencies": {
    "@paperclipai/hermes-paperclip-adapter": "file:voie1/paquets/paperclipai-hermes-paperclip-adapter-2026.1001.0-hc063.1.tgz",
    "yaml": "^2.6.0",
    "@paperclipai/adapter-utils": "file:voie1/paquets/paperclipai-adapter-utils-2026.1001.0-hc063.1.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyberServices-ai/hermes-control.git",
    "directory": "adapter"
  },
  "homepage": "https://github.com/CyberServices-ai/hermes-control#readme",
  "bugs": {
    "url": "https://github.com/CyberServices-ai/hermes-control/issues"
  },
  "keywords": [
    "paperclip",
    "paperclip-adapter",
    "hermes",
    "hermes-agent",
    "nous-research"
  ],
  "overrides": {
    "@paperclipai/adapter-utils": "$@paperclipai/adapter-utils",
    "@paperclipai/hermes-paperclip-adapter": "$@paperclipai/hermes-paperclip-adapter"
  }
}
